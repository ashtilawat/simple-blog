# Auth0
REACT_APP_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-client-id

# Airtable CMS
REACT_APP_AIRTABLE_API_KEY=your-airtable-api-key
REACT_APP_AIRTABLE_BASE_ID=your-airtable-base-id

# Optional Airtable table and field overrides (defaults shown)
# REACT_APP_AIRTABLE_CONTENT_ITEMS_TABLE=ContentItems
# REACT_APP_AIRTABLE_CONTENT_BLOCKS_TABLE=ContentBlocks
# REACT_APP_AIRTABLE_ITEM_TITLE_FIELD=Title
# REACT_APP_AIRTABLE_ITEM_SLUG_FIELD=Slug
# REACT_APP_AIRTABLE_ITEM_PUBLISHED_FIELD=Published
# REACT_APP_AIRTABLE_BLOCK_ITEM_FIELD=ContentItem
# REACT_APP_AIRTABLE_BLOCK_ORDER_FIELD=Order
# REACT_APP_AIRTABLE_BLOCK_TYPE_FIELD=Type
# REACT_APP_AIRTABLE_BLOCK_PAYLOAD_FIELD=Payload
